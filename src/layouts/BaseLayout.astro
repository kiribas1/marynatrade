---
interface Props {
  title: string;
  description: string;
  lang: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { title, description, lang, canonicalUrl, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = canonicalUrl || `${siteUrl}${currentPath}`;
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const locales = ['en', 'es', 'zh', 'ru', 'pt', 'ar'];
const langNames: Record<string, string> = {
  en: 'English',
  es: 'Español',
  zh: '中文',
  ru: 'Русский',
  pt: 'Português',
  ar: 'العربية',
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Hreflang -->
    {locales.map((loc) => {
      const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
      return <link rel="alternate" hreflang={loc} href={`${siteUrl}${path}`} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en/`} />

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2701690512336282"
      crossorigin="anonymous"
    ></script>

    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: #e2e8f0;
        background: #080a10;
        min-height: 100vh;
      }
      a {
        color: #10b981;
        text-decoration: none;
      }
      a:hover {
        color: #34d399;
        text-decoration: none;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* Header */
      header {
        background: rgba(8,10,16,0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(16,185,129,0.1);
        color: white;
        padding: 14px 0;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }
      .logo {
        font-size: 1.3rem;
        font-weight: 700;
        color: #10b981;
        letter-spacing: -0.02em;
      }
      .logo:hover {
        color: #34d399;
        text-decoration: none;
      }
      nav {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      nav a {
        color: #64748b;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.2s;
      }
      nav a:hover,
      nav a.active {
        color: #10b981;
        background: rgba(16,185,129,0.1);
        text-decoration: none;
      }

      /* Main */
      main {
        min-height: 70vh;
        padding: 0;
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 80px 20px 60px;
        background: radial-gradient(ellipse at 50% 0%, rgba(16,185,129,0.08) 0%, transparent 60%),
                    linear-gradient(180deg, #080a10 0%, #0c1018 100%);
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(16,185,129,0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(16,185,129,0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
      }
      .hero h1 {
        font-size: 2.8rem;
        margin-bottom: 8px;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #f1f5f9;
      }
      .hero .tagline {
        font-size: 1.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #10b981, #0d9488);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
      }
      .hero .lead {
        font-size: 1.1rem;
        color: #64748b;
        letter-spacing: 0.15em;
        font-weight: 500;
      }
      .hero-logo {
        border-radius: 50%;
        margin-bottom: 24px;
        border: 2px solid rgba(16,185,129,0.2);
        box-shadow: 0 0 40px rgba(16,185,129,0.15), 0 0 80px rgba(16,185,129,0.05);
        background: rgba(8,10,16,0.5);
        padding: 8px;
        position: relative;
        z-index: 1;
      }
      .hero-stats {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 32px;
        position: relative;
        z-index: 1;
      }
      .hero-stat {
        text-align: center;
      }
      .hero-stat-value {
        display: block;
        font-size: 0.8rem;
        color: #10b981;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .hero-stat-line {
        width: 30px;
        height: 2px;
        background: linear-gradient(90deg, #10b981, #0d9488);
        margin: 6px auto;
        border-radius: 2px;
      }

      /* Cards */
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin: 32px 0;
        padding: 0 20px;
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
      }
      .card {
        background: rgba(16,185,129,0.03);
        border: 1px solid rgba(16,185,129,0.08);
        border-radius: 12px;
        padding: 24px;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }
      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, #10b981, #0d9488, transparent);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .card:hover {
        border-color: rgba(16,185,129,0.25);
        background: rgba(16,185,129,0.06);
        transform: translateY(-3px);
        box-shadow: 0 8px 30px rgba(16,185,129,0.08);
      }
      .card:hover::before {
        opacity: 1;
      }
      .card-icon {
        font-size: 1.8rem;
        margin-bottom: 12px;
        display: block;
      }
      .card-tag {
        display: inline-block;
        font-size: 0.7rem;
        color: #0d9488;
        background: rgba(13,148,136,0.1);
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 10px;
      }
      .card h2 {
        font-size: 1.2rem;
        margin-bottom: 8px;
        color: #f1f5f9;
        font-weight: 600;
      }
      .card p {
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.6;
      }

      /* Ad Slots */
      .ad-slot {
        background: rgba(16,185,129,0.02);
        border: 1px dashed rgba(16,185,129,0.1);
        padding: 20px;
        text-align: center;
        margin: 24px auto;
        max-width: 1100px;
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #334155;
        font-size: 0.75rem;
        border-radius: 8px;
      }

      /* Registration */
      .registration-info {
        background: rgba(16,185,129,0.03);
        border: 1px solid rgba(16,185,129,0.1);
        border-radius: 12px;
        padding: 32px;
        margin: 40px auto;
        max-width: 1100px;
        text-align: center;
      }
      .registration-info h2 {
        margin-bottom: 16px;
        color: #10b981;
        font-size: 1.3rem;
        font-weight: 600;
      }
      .registration-info p {
        margin: 6px 0;
        color: #94a3b8;
        font-size: 0.9rem;
      }
      .registration-info strong {
        color: #cbd5e1;
      }
      .disclaimer {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid rgba(16,185,129,0.08);
        font-size: 0.8rem;
        color: #475569;
        font-style: italic;
      }

      /* Content container for quiz/news */
      .content-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px;
      }

      /* Footer */
      footer {
        background: rgba(8,10,16,0.95);
        border-top: 1px solid rgba(16,185,129,0.08);
        color: #475569;
        padding: 24px 0;
        text-align: center;
        font-size: 0.82rem;
      }
      footer a {
        color: #64748b;
      }
      footer a:hover {
        color: #10b981;
      }

      @media (max-width: 640px) {
        .hero {
          padding: 50px 16px 40px;
        }
        .hero h1 {
          font-size: 1.8rem;
        }
        .hero .tagline {
          font-size: 1.1rem;
        }
        .hero-stats {
          gap: 20px;
        }
        .hero-stat-value {
          font-size: 0.7rem;
        }
        .card-grid {
          grid-template-columns: 1fr;
          padding: 0 16px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <a class="logo" href={`/${lang}/`}><slot name="logo">Maryna-Trade</slot></a>
        <nav>
          {locales.map((loc) => {
            const path = currentPath.replace(`/${lang}/`, `/${loc}/`);
            return (
              <a href={path} class={loc === lang ? 'active' : ''}>
                {langNames[loc]}
              </a>
            );
          })}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} <slot name="footer-name">Maryna-Trade</slot>. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
