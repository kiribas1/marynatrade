  es: { title: "Quiz de Conocimientos de Trading", score: "Puntuacion", correct: "Correcto!", wrong: "Incorrecto!", next: "Siguiente Pregunta", playAgain: "Jugar de Nuevo", result: "Tu Resultado", of: "de", funFact: "Dato Curioso" },
  zh: { title: "交易知识测验", score: "得分", correct: "正确!", wrong: "错误!", next: "下一题", playAgain: "再玩一次", result: "你的成绩", of: "/", funFact: "趣味知识" },
  ru: { title: "Тест на знание трейдинга", score: "Счёт", correct: "Верно!", wrong: "Неверно!", next: "Следующий вопрос", playAgain: "Играть снова", result: "Ваш результат", of: "из", funFact: "Интересный факт" },
  pt: { title: "Quiz de Conhecimentos de Trading", score: "Pontuacao", correct: "Correto!", wrong: "Errado!", next: "Proxima Pergunta", playAgain: "Jogar Novamente", result: "Seu Resultado", of: "de", funFact: "Curiosidade" },
  ar: { title: "اختبار معرفة التداول", score: "النتيجة", correct: "صحيح!", wrong: "خطأ!", next: "السؤال التالي", playAgain: "العب مرة أخرى", result: "نتيجتك", of: "من", funFact: "حقيقة ممتعة" },
};

const l = labels[lang] || labels.en;
---

<section class="quiz-section" id="trading-quiz">
  <div class="quiz-container">
    <h2 class="quiz-title">{l.title}</h2>
    <div class="quiz-score-bar">
      <span class="quiz-score-label">{l.score}: <strong id="quiz-score">0</strong> / <span id="quiz-total">12</span></span>
      <span class="quiz-progress" id="quiz-progress">Q 1/12</span>
    </div>
    <div id="quiz-question-area">
      <p class="quiz-question" id="quiz-question"></p>
      <div class="quiz-options" id="quiz-options"></div>
    </div>
    <div class="quiz-feedback" id="quiz-feedback" style="display:none;">
      <p id="quiz-feedback-text"></p>
      <p class="quiz-funfact"><span class="funfact-label">{l.funFact}:</span> <span id="quiz-funfact"></span></p>
      <button class="quiz-next-btn" id="quiz-next-btn">{l.next}</button>
    </div>
    <div class="quiz-result" id="quiz-result" style="display:none;">
      <p class="result-title">{l.result}</p>
      <p class="result-score" id="result-score-text"></p>
      <button class="quiz-play-again-btn" id="quiz-play-again">{l.playAgain}</button>
    </div>
  </div>
</section>

