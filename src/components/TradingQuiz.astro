  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  let questions = shuffle(allQuestions).slice(0, 12);
  let current = 0;
  let score = 0;

  function renderQuestion() {
    const q = questions[current];
    document.getElementById('quiz-question').textContent = q.q[lang] || q.q.en;
    document.getElementById('quiz-progress').textContent = `Q ${current + 1}/12`;
    document.getElementById('quiz-feedback').style.display = 'none';
    document.getElementById('quiz-question-area').style.display = 'block';

    const optionsDiv = document.getElementById('quiz-options');
    optionsDiv.innerHTML = '';
    const opts = q.options[lang] || q.options.en;
    opts.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.className = 'quiz-option-btn';
      btn.textContent = opt;
      btn.addEventListener('click', () => handleAnswer(i));
      optionsDiv.appendChild(btn);
    });
  }

  function handleAnswer(idx) {
    const q = questions[current];
    const isCorrect = idx === q.correct;
    if (isCorrect) score++;
    document.getElementById('quiz-score').textContent = score;
    document.getElementById('quiz-question-area').style.display = 'none';
    document.getElementById('quiz-feedback').style.display = 'block';
    document.getElementById('quiz-feedback-text').textContent = isCorrect ? l.correct : l.wrong;
    document.getElementById('quiz-feedback-text').className = isCorrect ? 'feedback-correct' : 'feedback-wrong';
    document.getElementById('quiz-funfact').textContent = q.fact[lang] || q.fact.en;

    if (current >= 11) {
      document.getElementById('quiz-next-btn').style.display = 'none';
    }
  }

  document.getElementById('quiz-next-btn').addEventListener('click', () => {
    current++;
    if (current < 12) {
      renderQuestion();
    } else {
      document.getElementById('quiz-feedback').style.display = 'none';
      document.getElementById('quiz-result').style.display = 'block';
      document.getElementById('result-score-text').textContent = `${score} ${l.of} 12`;
    }
  });

  document.getElementById('quiz-play-again').addEventListener('click', () => {
    window.location.reload();
  });

  renderQuestion();
</script>

